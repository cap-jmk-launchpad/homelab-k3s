# agentic-book Shiphook route for the homelab k3s `blackpearl` Shiphook server.
# Mirrors shiphook.obsevia-demos.yaml.example — merge this entry into the server's
# `apps:` list in ~/staging/shiphook-server/shiphook.yaml on blackpearl.
#
# Shiphook routes by Host header + POST path, runs `git pull` in `repoPath`, then
# executes `runScript` (cwd = repoPath). repoPath is an agentic-book checkout so
# `git rev-parse HEAD` in the runScript matches the commit CI just deployed.
#
# apps:
#   - name: agentic-book
#     host: shiphook.agentic-book.org        # your Shiphook vhost (CNAME → blackpearl WAN)
#     path: /deploy/agentic-book
#     repoPath: /home/s4il0r/agentic-book   # `git clone` agentic-book-org/agentic-book here (one-time)
#     runScript: bash /home/s4il0r/staging/homelab-k3s/scripts/agentic-book-shiphook-deploy.sh
#     runTimeoutMs: 1800000
#     secret: <DEPLOY_TOKEN>               # same value as GitHub secret SHIPHOOK_DEPLOY_TOKEN
#
# Secret minting options (pick one):
#   A) Set `secret: <token>` explicitly in the app route above, and set the SAME
#      value as the GitHub secret `SHIPHOOK_DEPLOY_TOKEN` in agentic-book-org/agentic-book.
#   B) Omit `secret:` — Shiphook auto-generates a secure token and persists it to
#      `<repoPath>/.shiphook/agentic-book-org-deploy-agentic-book-<hash>.secret`
#      (mode 0600). `cat` that file to read the value, then set it as
#      `SHIPHOOK_DEPLOY_TOKEN` in the agentic-book GitHub repo.
